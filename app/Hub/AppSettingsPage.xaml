<UserControl x:Class="CoolPlayer.AppSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Аккаунт VK" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Background="{StaticResource Panel2}" CornerRadius="16" Padding="18,14">
                <DockPanel>
                    <Button x:Name="VkBtn" DockPanel.Dock="Right" Style="{StaticResource Pill}" Click="VkClick"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VkName" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VkHint" FontSize="12.5" Foreground="{StaticResource Fg2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Запуск" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <CheckBox x:Name="AutoStart" Content="Запускать Taskbeat вместе с Windows" Click="AutoStartClick"/>
            <CheckBox x:Name="StartHidden" Content="Открываться свёрнутым — только остров и значок в трее" Click="StartHiddenClick"/>

            <TextBlock Text="Режим" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <UniformGrid Columns="2">
                <RadioButton x:Name="ModeClassic" GroupName="perf" Margin="0,0,6,0" Checked="ModeChecked" Tag="classic">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{StaticResource Panel2}" CornerRadius="16" Padding="18,14" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="✦  Классический" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Fg2}" Margin="0,4,0,0"
                                               Text="Упор в дизайн: анимации острова, плавный текст песен, размытая обложка, живой эквалайзер."/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="ModeGame" GroupName="perf" Margin="6,0,0,0" Checked="ModeChecked" Tag="game">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{StaticResource Panel2}" CornerRadius="16" Padding="18,14" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="⚡  Игровой" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Fg2}" Margin="0,4,0,0"
                                               Text="Минимум ресурсов: без анимаций и лишних перерисовок, режим эффективности Windows, низкий приоритет, вкладки засыпают сразу."/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#30D158"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </UniformGrid>

            <TextBlock Text="Что делает игровой режим" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <Border Background="{StaticResource Panel2}" CornerRadius="16" Padding="18,12">
                <StackPanel x:Name="GameOpts"/>
            </Border>

            <TextBlock Text="Горячие клавиши" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <CheckBox x:Name="HotkeysOn" Content="Глобальные горячие клавиши — работают из любого окна и в играх" Click="HotkeysClick"/>
            <Border x:Name="HotkeyBox" Background="{StaticResource Panel2}" CornerRadius="16" Padding="18,8" Margin="0,8,0,0">
                <StackPanel x:Name="HotkeyRows"/>
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg3}" FontSize="12.5" Margin="0,6,0,0"
                       Text="Нажмите на сочетание, чтобы переназначить: зажмите новые клавиши. Esc — отмена, Backspace — вернуть по умолчанию."/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg3}" FontSize="12.5" Margin="0,6,0,0"
                       Text="Остров поверх игры показывается в оконном и безрамочном полноэкранном режиме. Эксклюзивный полноэкранный режим DirectX не пускает поверх себя никакие окна — там работают управление музыкой и громкостью."/>

            <TextBlock Text="Производительность" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <CheckBox x:Name="Suspend" Content="Усыплять скрытые вкладки сервисов, если они ничего не играют" Click="SuspendClick"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg3}" FontSize="12.5" Margin="0,4,0,0"
                       Text="Вкладки YouTube, SoundCloud и Яндекс Музыки запускаются только при первом открытии. Закрытие окна Taskbeat не останавливает музыку — плеер продолжит играть, а остров останется на месте."/>

            <TextBlock Text="О программе" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Logo}" Width="52" Height="52"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Taskbeat" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Музыкальный плеер с островом на панели задач" FontSize="12.5" Foreground="{StaticResource Fg2}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="VersionText" FontSize="12.5" Foreground="{StaticResource Fg3}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Данные и приватность" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="12.5" LineHeight="19"
                       Text="Taskbeat не собирает статистику и ничего не отправляет разработчику. Ключ доступа VK хранится на этом компьютере в зашифрованном виде (Windows DPAPI), пароль не сохраняется. Настройки лежат в %APPDATA%\Taskbeat. Запросы уходят только в сервисы, которыми вы пользуетесь: VK, YouTube, SoundCloud, Яндекс Музыка, Spotify, а также Open-Meteo (погода) и LrcLib (тексты песен)."/>
            <TextBlock Text="Сторонние компоненты" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="12.5" LineHeight="19">
                • Погода — Open-Meteo.com, данные под лицензией CC BY 4.0<LineBreak/>
                • Синхронные тексты — LrcLib.net<LineBreak/>
                • QRCoder — лицензия MIT<LineBreak/>
                • Microsoft Edge WebView2 — лицензия Microsoft<LineBreak/>
                • .NET и WPF — лицензия MIT
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg3}" FontSize="12" Margin="0,12,0,0" LineHeight="18"
                       Text="Taskbeat — независимый проект, не связанный с VK, YouTube, SoundCloud, Яндексом, Spotify или Apple. Названия сервисов принадлежат их владельцам."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
