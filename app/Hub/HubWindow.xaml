<Window x:Class="CoolPlayer.HubWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbeat"
        Icon="/Assets/taskbeat.ico"
        Width="1200" Height="780" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= боковое меню -->
        <Border Background="{StaticResource Panel}">
            <DockPanel Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,8">
                    <Image Source="{StaticResource Logo}" Width="36" Height="36"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Taskbeat" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                        <TextBlock Text="музыка на панели задач" FontSize="11" Foreground="{StaticResource Fg2}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource Nav}" GroupName="feedback" Tag="&#xED15;" Content="Отзыв или баг" Click="FeedbackClick"/>
                    <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE7C4;" Content="Остров" x:Name="NavIsland" Checked="NavChecked" Uid="island"/>
                    <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE713;" Content="Настройки" Checked="NavChecked" Uid="settings"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav">
                        <TextBlock Style="{StaticResource NavHeader}" Text="VK МУЗЫКА"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xEB51;" Content="Моя музыка" Checked="NavChecked" Uid="vk:my"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE734;" Content="Рекомендации" Checked="NavChecked" Uid="vk:recs"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE90B;" Content="Плейлисты" Checked="NavChecked" Uid="vk:playlists"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE721;" Content="Поиск" Checked="NavChecked" Uid="vk:search"/>

                        <TextBlock Style="{StaticResource NavHeader}" Text="БИБЛИОТЕКА"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE8FD;" Content="Очередь" Checked="NavChecked" Uid="vk:queue"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE81C;" Content="История" Checked="NavChecked" Uid="vk:history"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE7F8;" Content="На компьютере" Checked="NavChecked" Uid="local"/>

                        <TextBlock Style="{StaticResource NavHeader}" Text="СЕРВИСЫ"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE714;" Content="YouTube" Checked="NavChecked" Uid="web:youtube"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE753;" Content="SoundCloud" Checked="NavChecked" Uid="web:soundcloud"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE8D6;" Content="Яндекс Музыка" Checked="NavChecked" Uid="web:yandex"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE7F4;" Content="Пульт · Spotify" Checked="NavChecked" Uid="remote"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= контент -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="32,0,0,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="MinClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource Caption}" x:Name="MaxBtn" Content="&#xE922;" Click="MaxClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="CloseClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>
            <ContentControl x:Name="LyricsHost" Grid.RowSpan="2" Focusable="False" Visibility="Collapsed" Margin="0,44,0,0"/>
        </Grid>

        <!-- настройки воспроизведения -->
        <Popup x:Name="PlaySettings" PlacementTarget="{Binding ElementName=PlaySettingsBtn}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-10" HorizontalOffset="-150">
            <Border Background="{StaticResource Panel2}" CornerRadius="16" Padding="20,16,20,18" Width="340" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Настройки воспроизведения" FontSize="16" FontWeight="SemiBold"/>

                    <DockPanel Margin="0,16,0,0">
                        <CheckBox x:Name="CrossfadeOn" DockPanel.Dock="Right" Click="CrossfadeToggle" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Плавный переход между треками" FontSize="13.5"/>
                            <TextBlock x:Name="CrossfadeText" Text="Сглаживает переключение музыки" FontSize="12" Foreground="{StaticResource Fg2}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="CrossfadeLen" Style="{StaticResource Thin}" Minimum="1" Maximum="12" Margin="0,10,0,0"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="CrossfadeLenChanged"/>

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="14,6" Content="Настроить" Click="EqClick" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Эквалайзер" FontSize="13.5"/>
                            <TextBlock x:Name="EqText" FontSize="12" Foreground="{StaticResource Fg2}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Таймер сна" FontSize="13.5" Margin="0,18,0,0"/>
                    <TextBlock x:Name="SleepText" Text="Выключен" FontSize="12" Foreground="{StaticResource Fg2}" Margin="0,2,0,8"/>
                    <WrapPanel x:Name="SleepButtons">
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="Выкл" Tag="0" Click="SleepClick"/>
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="15 мин" Tag="15" Click="SleepClick"/>
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="30 мин" Tag="30" Click="SleepClick"/>
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="45 мин" Tag="45" Click="SleepClick"/>
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="1 час" Tag="60" Click="SleepClick"/>
                        <Button Style="{StaticResource Pill}" Padding="12,6" Margin="0,0,6,6" Content="Конец трека" Tag="-1" Click="SleepClick"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= плеер -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Height="92" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                    <ColumnDefinition Width="2*" MaxWidth="640"/>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- трек -->
                <DockPanel VerticalAlignment="Center">
                    <Border x:Name="ArtBox" Width="58" Height="58" CornerRadius="10" Background="{StaticResource Panel2}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Fg3}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush x:Name="Art" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BarTitle" Text="Ничего не играет" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarArtist" Text="Выберите трек" FontSize="12.5" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock x:Name="BarSource" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- управление -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ShuffleBtn" Style="{StaticResource Icon}" Content="&#xE8B1;" ToolTip="Перемешать" Click="ShuffleClick"/>
                        <Button Style="{StaticResource Icon}" Content="&#xE892;" ToolTip="Назад" Click="PrevClick" Margin="6,0"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Content="&#xE768;" Click="PlayClick" Margin="4,0"/>
                        <Button Style="{StaticResource Icon}" Content="&#xE893;" ToolTip="Вперёд" Click="NextClick" Margin="6,0"/>
                        <Button x:Name="RepeatBtn" Style="{StaticResource Icon}" Content="&#xE8ED;" ToolTip="Повторять трек" Click="RepeatClick"/>
                    </StackPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock x:Name="PosText" DockPanel.Dock="Left" Width="44" FontSize="11" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DurText" DockPanel.Dock="Right" Width="44" FontSize="11" Foreground="{StaticResource Fg2}" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="Progress" Style="{StaticResource Thin}" Minimum="0" Maximum="1"
                                PreviewMouseLeftButtonDown="ProgressDown" PreviewMouseLeftButtonUp="ProgressUp"/>
                    </DockPanel>
                </StackPanel>

                <!-- справа -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MoreBtn" Style="{StaticResource Icon}" Content="&#xE712;" ToolTip="Действия с треком" Click="MoreClick"/>
                    <Button x:Name="LyricsBtn" Style="{StaticResource Icon}" Content="&#xE8A5;" ToolTip="Текст песни" Click="LyricsClick"/>
                    <Button x:Name="PlaySettingsBtn" Style="{StaticResource Icon}" Content="&#xE9E9;" ToolTip="Настройки воспроизведения" Click="PlaySettingsClick"/>
                    <Button x:Name="PipBtn" Style="{StaticResource Icon}" Content="&#xEE49;" ToolTip="Видео в картинку-в-картинке" Click="PipClick" Visibility="Collapsed"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE7C4;" ToolTip="Настройки острова" Click="IslandClick"/>
                    <TextBlock x:Name="VolIcon" Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Fg2}"
                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                    <Slider x:Name="Volume" Style="{StaticResource Thin}" Width="110" Minimum="0" Maximum="1" ValueChanged="VolumeChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- всплывающее сообщение -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                Background="{StaticResource Hover}" CornerRadius="18" Padding="18,9" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>
    </Grid>
</Window>
