<UserControl x:Class="CoolPlayer.IslandSettingsPage"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoolPlayer">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Margin="26,0,26,0">

            <!-- ============================ ОСТРОВ -->
            <TabItem Header="Остров">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,16,20,20">
                        <TextBlock Text="В покое" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <RadioButton GroupName="idle" Content="Уходить в полоску на верхнем крае панели" IsChecked="{Binding CollapseToStrip}"/>
                        <RadioButton GroupName="idle" Content="Всегда оставаться пилюлей" IsChecked="{Binding KeepPill}"/>
                        <CheckBox Content="Полоска на всю ширину панели" IsChecked="{Binding StripFullWidth}" Margin="0,8,0,0"/>
                        <CheckBox Content="Показывать на полоске прогресс трека на паузе" IsChecked="{Binding StripProgress}"/>

                        <TextBlock Text="Что показывать в пилюле" Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{x:Static local:Options.InfoKinds}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                  SelectedValue="{Binding IdleContent}" Width="260" HorizontalAlignment="Left"/>
                        <TextBlock Text="Действует, когда остров не уходит в полоску. Правила на вкладке «Расписание» важнее."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="Положение" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="По центру" Click="CenterOffset" Margin="12,0,0,0"/>
                            <TextBlock DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0:0} px}"/>
                            <Slider x:Name="OffsetSlider" Minimum="-900" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding OffsetX}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Смещение от центра панели задач — если иконки стоят по центру, сдвиньте остров в сторону."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="Размер острова" Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{x:Static local:Options.Scales}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                  SelectedValue="{Binding IslandScale}" Width="260" HorizontalAlignment="Left"/>
                        <TextBlock Text="«Авто» делает остров крупнее на 2K- и 4K-мониторах, где он иначе выглядит мелким."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <CheckBox Content="Полоска на всех мониторах" IsChecked="{Binding AllMonitors}" Margin="0,12,0,0"/>
                        <TextBlock Text="Остров раскрывается на том мониторе, где вы навели курсор. Напоминания и уведомления — на основном."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <TextBlock Text="События" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
                        <CheckBox Content="Показывать название нового трека" IsChecked="{Binding TrackPeek}"/>
                        <CheckBox Content="«Скопировано» при копировании в буфер" IsChecked="{Binding ClipboardToast}"/>
                        <CheckBox Content="Подключение и отключение зарядки" IsChecked="{Binding PowerToast}"/>
                        <CheckBox Content="Уведомления Windows (сообщения, почта и т. д.)" IsChecked="{Binding WinNotifications}"/>
                        <CheckBox Content="Не показывать стандартные всплывающие окна Windows, пока Taskbeat запущен" IsChecked="{Binding HideWinBanners}" Margin="24,0,0,0"
                                  IsEnabled="{Binding WinNotifications}"/>
                        <TextBlock Text="Уведомления остаются в центре уведомлений Windows. При выходе из Taskbeat всплывающие окна возвращаются."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="24,2,0,0"/>
                        <CheckBox Content="Звук напоминаний" IsChecked="{Binding ReminderSound}"/>

                        <TextBlock Text="Система" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,8"/>
                        <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ РАСПИСАНИЕ -->
            <TabItem Header="Расписание">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,16,20,20">
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"
                                   Text="В указанное время остров вместо полоски покажет выбранную информацию. Например, с 7:00 до 9:00 — погоду, а вечером — ближайшее напоминание. Музыка и уведомления всё равно важнее. Время пишется как 07:30; интервал может переходить через полночь."/>
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <WrapPanel>
                                                <CheckBox IsChecked="{Binding Enabled}" Content="Вкл." MinWidth="0" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="с" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                <TextBlock Text="до" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                                <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                <ComboBox ItemsSource="{x:Static local:Options.InfoKinds}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                                          SelectedValue="{Binding Content}" Width="230" Margin="14,0,0,0"/>
                                                <Button Content="Удалить" Click="DeleteRule" Margin="14,0,0,0"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,10,0,0">
                                                <CheckBox Content="Пн" IsChecked="{Binding Mon}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Вт" IsChecked="{Binding Tue}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Ср" IsChecked="{Binding Wed}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Чт" IsChecked="{Binding Thu}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Пт" IsChecked="{Binding Fri}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Сб" IsChecked="{Binding Sat}" MinWidth="0" Margin="0,0,12,0"/>
                                                <CheckBox Content="Вс" IsChecked="{Binding Sun}" MinWidth="0"/>
                                            </WrapPanel>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock Text="Свой текст:" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.75"/>
                                                <TextBox Text="{Binding CustomText}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Добавить правило" Click="AddRule" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ НАПОМИНАНИЯ -->
            <TabItem Header="Напоминания">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,16,20,20">
                        <TextBlock Text="Новое напоминание" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="RemText"/>
                        <WrapPanel Margin="0,10,0,0">
                            <DatePicker x:Name="RemDate" Width="170"/>
                            <TextBox x:Name="RemTime" Width="80" Text="18:00" Margin="10,0,0,0" ToolTip="Время, например 18:30"/>
                            <ComboBox x:Name="RemRepeat" ItemsSource="{x:Static local:Options.Repeats}" DisplayMemberPath="Name"
                                      SelectedValuePath="Value" SelectedIndex="0" Width="190" Margin="10,0,0,0"/>
                            <Button Content="Добавить" Click="AddReminder" Style="{StaticResource PillAccent}" Margin="10,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="RemError" Foreground="#FF6B6B" Margin="0,8,0,0"/>
                        <TextBlock Text="В назначенное время остров раскроется с текстом и кнопками «Готово» и «Отложить»."
                                   Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock Text="Запланировано" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,8"/>
                        <TextBlock x:Name="RemEmpty" Text="Пока ничего нет" Opacity="0.6"/>
                        <ItemsControl x:Name="RemList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Удалить" Click="DeleteReminder" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ ПОГОДА -->
            <TabItem Header="Погода">
                <StackPanel Margin="4,16,20,20">
                    <TextBlock Text="Город" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <TextBox x:Name="CityBox" Width="300" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Найти" Click="FindCity" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="CityStatus" Margin="0,10,0,0" Opacity="0.85"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,18,0,0"
                               Text="Погода берётся из Open-Meteo (бесплатно, без ключа) и обновляется раз в 30 минут. Туда уходят только координаты выбранного города."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="32,12,32,18" LastChildFill="False">
            <TextBlock x:Name="SaveError" DockPanel.Dock="Left" Foreground="#FF6B6B" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            <Button DockPanel.Dock="Right" Content="Отменить изменения" Click="CloseClick" Margin="10,0,0,0" MinWidth="100"/>
            <Button DockPanel.Dock="Right" Content="Сохранить" Click="SaveClick" Style="{StaticResource PillAccent}" MinWidth="120"/>
        </DockPanel>
    </Grid>
</UserControl>
