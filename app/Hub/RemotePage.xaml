<UserControl x:Class="CoolPlayer.RemotePage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="13.5" LineHeight="20" Margin="0,0,0,18"
                       Text="Всё, что сейчас играет в Windows: приложения Spotify и Яндекс Музыки, браузеры, плееры. Управляйте ими отсюда или с острова — без переключения окон."/>

            <WrapPanel Margin="0,0,0,22">
                <Button Style="{StaticResource Pill}" Click="OpenSpotify" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#1ED760" Margin="0,0,8,0"/>
                        <TextBlock Text="Открыть Spotify"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Pill}" Click="OpenYandexWeb">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#FFCC00" Margin="0,0,8,0"/>
                        <TextBlock Text="Яндекс Музыка во вкладке"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock x:Name="Empty" Text="Сейчас ничего не играет" Foreground="{StaticResource Fg3}" FontSize="14" Margin="2,10,0,0"/>

            <ItemsControl x:Name="Sessions">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Panel2}" CornerRadius="18" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="14" Background="{Binding Color}">
                                    <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="Bold" Foreground="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding App}" FontSize="11.5" Foreground="{StaticResource Fg2}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Icon}" Content="&#xE892;" Click="PrevClick"/>
                                    <Button Style="{StaticResource PlayBtn}" Content="{Binding PlayGlyph}" Click="ToggleClick" Margin="6,0"/>
                                    <Button Style="{StaticResource Icon}" Content="&#xE893;" Click="NextClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
