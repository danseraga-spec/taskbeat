<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Taskbeat</AssemblyName>
    <RootNamespace>CoolPlayer</RootNamespace>
    <Product>Taskbeat</Product>
    <AssemblyTitle>Taskbeat</AssemblyTitle>
    <Version>1.2.0</Version>
    <Copyright>© 2026</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\taskbeat.ico</ApplicationIcon>
    <StartupObject>CoolPlayer.Program</StartupObject>

    <!-- лёгкий рантайм -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\taskbeat.ico" />
  </ItemGroup>

  <!-- ключи Last.fm и Discord: app/keys.props не в git (пример: keys.props.example) -->
  <Import Project="keys.props" Condition="Exists('keys.props')" />
  <ItemGroup>
    <AssemblyMetadata Include="LastFmKey" Value="$(LastFmKey)" />
    <AssemblyMetadata Include="LastFmSecret" Value="$(LastFmSecret)" />
    <AssemblyMetadata Include="DiscordAppId" Value="$(DiscordAppId)" />
  </ItemGroup>

</Project>
